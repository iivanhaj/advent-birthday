# Copy to .env.local for local dev. On Vercel, set these in Project → Settings → Environment Variables.

# Supabase → Project Settings → API. The anon (or "publishable") key is safe in the browser: RLS guards it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The service-role (or "secret") key bypasses RLS. Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Any long random string; paste the same value into the GitHub webhook's "Secret" field.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GITHUB_WEBHOOK_SECRET=

# Open every door locally so you can work on future ones. Ignored on Vercel production.
# With it on, add ?preview=mixed or ?preview=finale to the URL to fake pushed/shipped doors.
DEV_UNLOCK_ALL=false
